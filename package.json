{
  "name": "@johnmorrisdotca/tsunagi",
  "version": "1.1.0",
  "description": "Tsunagi, a line-joining logic puzzle (Flow-style number link) for JavaScript and TypeScript: layouts and answers as short codes, the rules a line keeps, a solver that counts answers, a seeded generator, walls, bridges, waypoints and hexagon boards, a difficulty measure, and 1,792 hand-checked levels from 4×4 to 12×12, each with exactly one answer. The board drawn as SVG (colours or numbers, dots or lines) and played by touch and mouse in any page, as a function call or a tag. Zero dependencies.",
  "keywords": [
    "puzzle",
    "logic-puzzle",
    "number-link",
    "numberlink",
    "flow-free",
    "flow-puzzle",
    "line-puzzle",
    "path-puzzle",
    "arukone",
    "puzzle-generator",
    "puzzle-solver",
    "levels",
    "hexagon",
    "seeded-random",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu",
    "svg",
    "custom-element",
    "web-component"
  ],
  "homepage": "https://github.com/johnmorrisdotca/tsunagi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/tsunagi.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/tsunagi/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./draw": {
      "types": "./dist/draw-entry.d.ts",
      "import": "./dist/draw-entry.js",
      "default": "./dist/draw-entry.js"
    },
    "./play": {
      "types": "./dist/play-entry.d.ts",
      "import": "./dist/play-entry.js",
      "default": "./dist/play-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
