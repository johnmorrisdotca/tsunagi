      "default": "./dist/levels/size6.data.js"
    },
    "./levels-7": {
      "types": "./dist/levels/size7.data.d.ts",
      "import": "./dist/levels/size7.data.js",
      "default": "./dist/levels/size7.data.js"
    },
    "./levels-8": {
      "types": "./dist/levels/size8.data.d.ts",
      "import": "./dist/levels/size8.data.js",
      "default": "./dist/levels/size8.data.js"
    },
    "./levels-9": {
      "types": "./dist/levels/size9.data.d.ts",
