{
  "name": "@johnmorrisdotca/tsunagi",
  "version": "1.6.3",
  "description": "Tsunagi, a line-joining logic puzzle (Flow-style number link) for JavaScript and TypeScript: 2,368 hand-checked levels with one answer each, a solver, a seeded generator, walls, bridges, portals, hexagons and an SVG board. Zero dependencies.",
  "keywords": [
    "puzzle",
    "logic-puzzle",
    "number-link",
    "numberlink",
    "flow-free",
    "flow-puzzle",
    "line-puzzle",
    "path-puzzle",
    "arukone",
    "puzzle-generator",
    "puzzle-solver",
    "levels",
    "hexagon",
    "seeded-random",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu",
    "svg",
    "custom-element",
    "web-component",
    "portals",
    "big-boards"
  ],
  "homepage": "https://johnmorrisdotca.github.io/tsunagi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/tsunagi.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/tsunagi/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./draw": {
      "types": "./dist/draw-entry.d.ts",
      "import": "./dist/draw-entry.js",
      "default": "./dist/draw-entry.js"
    },
    "./play": {
      "types": "./dist/play-entry.d.ts",
      "import": "./dist/play-entry.js",
      "default": "./dist/play-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./levels": {
      "types": "./dist/levels.d.ts",
      "import": "./dist/levels.js",
      "default": "./dist/levels.js"
    },
    "./levels-4": {
      "types": "./dist/levels/size4.data.d.ts",
      "import": "./dist/levels/size4.data.js",
      "default": "./dist/levels/size4.data.js"
    },
    "./levels-5": {
